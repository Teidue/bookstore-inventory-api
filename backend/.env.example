# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores.  El `.env` real NUNCA se
# versiona (está en .gitignore).  La API valida todas las variables al
# arrancar: si falta una obligatoria o tiene un valor inválido, no arranca e
# indica cuál es.
# ---------------------------------------------------------------------------

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# --- Base de datos PostgreSQL ---------------------------------------------
# OBLIGATORIAS: DB_HOST, DB_USER, DB_PASSWORD y DB_NAME.
# `npm run db:crear` crea la base si no existe, así que DB_USER necesita
# permiso para crear bases de datos (por ejemplo, el usuario postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_password
DB_NAME=bookstore_inventory

# Opcional. Esquema de PostgreSQL; sin definir se usa `public`.  Lo usan los
# tests de integración para aislarse en un esquema efímero.  En uso normal,
# déjala comentada: vacía no es un valor válido.
# DB_SCHEMA=

# --- Cálculo de precio de venta -------------------------------------------
# Moneda local a la que se convierte el coste en USD (código ISO 4217).
LOCAL_CURRENCY=EUR

# Margen de ganancia aplicado sobre el coste, en porcentaje.
PROFIT_MARGIN_PERCENTAGE=40

# --- Integración con la API de tasas de cambio ------------------------------
EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Tiempo máximo de espera de la API externa, en milisegundos.
EXCHANGE_TIMEOUT_MS=5000

# Cuánto se reutiliza una tasa ya consultada, en segundos.  Las tasas cambian
# una vez al día: pedirlas en cada cálculo sería gastar la cuota sin motivo.
EXCHANGE_CACHE_TTL_SECONDS=600

# Tasa que se usa si la API externa falla, tal y como exige el enunciado.
# Déjala vacía para que la API responda 503 en lugar de inventar un precio.
EXCHANGE_FALLBACK_RATE=0.92

# --- CORS ------------------------------------------------------------------
# Origen del frontend; varios, separados por comas.
CORS_ORIGIN=http://localhost:5173

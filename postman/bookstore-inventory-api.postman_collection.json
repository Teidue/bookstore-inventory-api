{
  "info": {
    "name": "Bookstore Inventory API",
    "description": "Colección de la API de gestión de inventario de librerías.\n\nSe ejecuta de arriba abajo con el Runner sin tocar nada y se puede repetir: cada ejecución genera su propio ISBN válido y borra al final el libro que crea.\n\nAntes de empezar, comprueba la variable `base_url` (por defecto http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. CRUD de libros",
      "item": [
        {
          "name": "Crear libro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Crea un libro. `selling_price_local` no se acepta en el cuerpo: lo calcula el endpoint de precio. El ISBN se genera solo (variable `isbn`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": 15.99,\n  \"stock_quantity\": 25,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ISBN-13 único en cada ejecución y con dígito de control correcto: así la colección",
                  "// se puede lanzar las veces que haga falta sin chocar con el 409 de ISBN duplicado.",
                  "const stem = '978' + String(Date.now()).slice(-9);",
                  "const sum = [...stem].reduce((acc, d, i) => acc + Number(d) * (i % 2 === 0 ? 1 : 3), 0);",
                  "pm.collectionVariables.set('isbn', stem + ((10 - (sum % 10)) % 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const book = pm.response.json();",
                  "pm.test('el precio de venta nace nulo', () => pm.expect(book.selling_price_local).to.be.null);",
                  "pm.test('devuelve los 11 campos del modelo', () => {",
                  "  ['id','title','author','isbn','cost_usd','selling_price_local','stock_quantity','category','supplier_country','created_at','updated_at']",
                  "    .forEach((k) => pm.expect(book).to.have.property(k));",
                  "});",
                  "pm.collectionVariables.set('book_id', book.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar libros (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Listado con paginación calculada por el servidor. Admite también `category`, `search` y `low_stock_threshold`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('trae data y meta de paginación', () => {",
                  "  pm.expect(page.data).to.be.an('array');",
                  "  ['total', 'page', 'limit', 'total_pages'].forEach((k) => pm.expect(page.meta).to.have.property(k));",
                  "});",
                  "pm.test('respeta el límite pedido', () => pm.expect(page.data.length).to.be.at.most(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener libro por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('es el libro pedido', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('book_id'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar libro",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "description": "PUT reemplaza el recurso completo (salvo el precio calculado). Deja el stock en 5 para que aparezca en la búsqueda de stock bajo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": 15.99,\n  \"stock_quantity\": 5,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('aplica el nuevo stock', () => pm.expect(pm.response.json().stock_quantity).to.eql(5));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Búsquedas (opcionales del enunciado)",
      "item": [
        {
          "name": "Buscar por categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/search?category=Literatura",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "search"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Literatura"
                }
              ]
            },
            "description": "La búsqueda es parcial y no distingue mayúsculas: «Literatura» encuentra «Literatura Clásica»."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('todos los resultados coinciden con la categoría', () => {",
                  "  pm.expect(page.data.length).to.be.above(0);",
                  "  page.data.forEach((b) => pm.expect(b.category.toLowerCase()).to.include('literatura'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Libros con stock bajo (umbral 10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/low-stock?threshold=10&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "low-stock"
              ],
              "query": [
                {
                  "key": "threshold",
                  "value": "10"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('todos tienen stock igual o menor que el umbral', () => page.data.forEach((b) => pm.expect(b.stock_quantity).to.be.at.most(10)));",
                  "pm.test('incluye el libro creado (stock 5)', () => pm.expect(page.data.map((b) => b.id)).to.include(Number(pm.collectionVariables.get('book_id'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Libros con stock bajo (umbral por defecto)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/low-stock?limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "low-stock"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Sin `threshold` el umbral es 10, como indica el enunciado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('aplica el umbral por defecto de 10', () => pm.response.json().data.forEach((b) => pm.expect(b.stock_quantity).to.be.at.most(10)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Cálculo de precio (integración externa)",
      "description": "Consulta la API de tasas de cambio. Si no responde, usa la tasa de respaldo (`EXCHANGE_FALLBACK_RATE`) y lo indica en `rate_source: \"fallback\"`. Para ver el 503, arranca la API con `EXCHANGE_API_URL` inválida y `EXCHANGE_FALLBACK_RATE` vacía: esa situación no se puede provocar desde Postman.",
      "item": [
        {
          "name": "Calcular precio de venta",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}/calculate-price",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}",
                "calculate-price"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const calc = pm.response.json();",
                  "pm.test('devuelve el desglose completo del enunciado', () => {",
                  "  ['book_id','cost_usd','exchange_rate','cost_local','margin_percentage','selling_price_local','currency','calculation_timestamp']",
                  "    .forEach((k) => pm.expect(calc).to.have.property(k));",
                  "});",
                  "pm.test('el margen es del 40%', () => pm.expect(calc.margin_percentage).to.eql(40));",
                  "pm.test('cost_local = coste × tasa', () => pm.expect(calc.cost_local).to.be.closeTo(calc.cost_usd * calc.exchange_rate, 0.011));",
                  "pm.test('precio de venta = coste local × 1,4', () => pm.expect(calc.selling_price_local).to.be.closeTo(calc.cost_local * 1.4, 0.011));",
                  "pm.collectionVariables.set('selling_price', calc.selling_price_local);"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprobar que el precio quedó guardado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('selling_price_local se actualizó en la base de datos', () => pm.expect(pm.response.json().selling_price_local).to.eql(Number(pm.collectionVariables.get('selling_price'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar el coste reinicia el precio de venta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const book = pm.response.json();",
                  "pm.test('el coste nuevo se guarda', () => pm.expect(book.cost_usd).to.eql(20));",
                  "pm.test('el precio calculado vuelve a null: correspondía al coste anterior', () => pm.expect(book.selling_price_local).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": 20,\n  \"stock_quantity\": 5,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            },
            "description": "Si el PUT cambia `cost_usd`, el precio de venta ya calculado deja de ser válido y vuelve a `null` hasta que se calcule de nuevo. Si el coste no cambia, el precio se conserva."
          }
        }
      ]
    },
    {
      "name": "4. Errores esperados",
      "item": [
        {
          "name": "400 - ISBN con formato inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"12345\",\n  \"cost_usd\": 15.99,\n  \"stock_quantity\": 25,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('el error tiene la forma uniforme', () => {",
                  "  const e = pm.response.json();",
                  "  ['statusCode', 'code', 'message', 'path', 'timestamp'].forEach((k) => pm.expect(e).to.have.property(k));",
                  "});",
                  "pm.test('código VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - coste menor o igual que 0",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"9780306406157\",\n  \"cost_usd\": 0,\n  \"stock_quantity\": 25,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('código VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - stock negativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"9780306406157\",\n  \"cost_usd\": 15.99,\n  \"stock_quantity\": -1,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('código VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - libro inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "999999"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));",
                  "pm.test('el error tiene la forma uniforme', () => {",
                  "  const e = pm.response.json();",
                  "  ['statusCode', 'code', 'message', 'path', 'timestamp'].forEach((k) => pm.expect(e).to.have.property(k));",
                  "});",
                  "pm.test('código BOOK_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('BOOK_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - calcular precio de un libro inexistente",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/999999/calculate-price",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "999999",
                "calculate-price"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));",
                  "pm.test('código BOOK_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('BOOK_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - ISBN duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Repite el ISBN del libro creado al principio. Va antes del borrado porque necesita que ese libro exista.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": 15.99,\n  \"stock_quantity\": 25,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 409', () => pm.response.to.have.status(409));",
                  "pm.test('el error tiene la forma uniforme', () => {",
                  "  const e = pm.response.json();",
                  "  ['statusCode', 'code', 'message', 'path', 'timestamp'].forEach((k) => pm.expect(e).to.have.property(k));",
                  "});",
                  "pm.test('código DUPLICATE_ISBN', () => pm.expect(pm.response.json().code).to.eql('DUPLICATE_ISBN'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Limpieza",
      "item": [
        {
          "name": "Eliminar libro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "description": "Va al final para que los casos de error anteriores aún tengan el libro sobre el que actuar y la colección se pueda repetir."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprobar que ya no existe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404 tras borrarlo', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "book_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "isbn",
      "value": "",
      "type": "string"
    },
    {
      "key": "selling_price",
      "value": "",
      "type": "string"
    }
  ]
}
